{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_BUILD_CHANNEL": "development" }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_BUILD_CHANNEL": "preview" }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "autoIncrement": "version",
        "buildType": "apk"
      },
      "env": { "EXPO_PUBLIC_BUILD_CHANNEL": "production" }
    }
  }
}
