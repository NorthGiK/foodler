{
  "name": "food-spend-tracker",
  "version": "1.3.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "generate:api": "openapi-ts && prettier --write \"src/api/generated/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"{src/api/**/*.{ts,tsx},*.{js,json,ts}}\"",
    "format": "prettier --write \"{App.tsx,src/**/*.{ts,tsx},*.{js,json,ts}}\"",
    "test": "jest",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-vector-icons/material-icons": "13.1.2",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@shopify/react-native-skia": "2.10.1",
    "expo": "~57.0.10",
    "expo-camera": "~57.0.3",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "ngrok": "^5.0.0-beta.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-animated-glow": "^3.1.0",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-markdown-display": "^7.0.2",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "~5.8.1",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "^0.11.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.5",
    "eslint": "^10.8.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.2",
    "jest-expo": "~57.0.3",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "react": "19.2.3",
    "brace-expansion@^1.1.7": "1.1.18",
    "js-yaml": "4.3.0",
    "react-native-markdown-display": {
      "markdown-it": "15.0.0"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "@shopify/react-native-skia@2.6.2": true,
    "core-js@2.6.12": true,
    "unrs-resolver@1.12.2": true
  }
}
