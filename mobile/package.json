{
  "name": "food-spend-tracker",
  "version": "1.3.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "generate:api": "openapi-ts && prettier --write \"src/api/generated/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"{src/api/**/*.{ts,tsx},*.{js,json,ts}}\"",
    "format": "prettier --write \"{App.tsx,src/**/*.{ts,tsx},*.{js,json,ts}}\"",
    "test": "jest",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-vector-icons/material-icons": "13.1.2",
    "@react-navigation/native": "^7.3.7",
    "@react-navigation/native-stack": "^7.17.9",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~56.0.19",
    "expo-camera": "~56.0.8",
    "expo-dev-client": "~56.0.23",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-image-picker": "~56.0.23",
    "expo-linear-gradient": "~56.0.4",
    "expo-navigation-bar": "~56.0.3",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "ngrok": "^5.0.0-beta.2",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-animated-glow": "^3.1.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-markdown-display": "^7.0.2",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "^0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@hey-api/openapi-ts": "0.97.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.2",
    "jest-expo": "~56.0.0",
    "prettier": "^3.2.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "brace-expansion@^1.1.7": "1.1.18",
    "js-yaml": "4.3.0",
    "react-native-markdown-display": {
      "markdown-it": "15.0.0"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "@shopify/react-native-skia@2.6.2": true,
    "core-js@2.6.12": true,
    "unrs-resolver@1.12.2": true
  }
}
