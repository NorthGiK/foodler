{
  "expo": {
    "name": "Foodler",
    "slug": "foodler",
    "scheme": "foodler",
    "version": "3.1.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/FoodlerIcon.png",
    "android": {
      "versionCode": 11,
      "package": "com.Foodler.chih_pih",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-camera",
      "expo-sqlite",
      "expo-font",
      "./plugins/with-observability-android",
      "@react-native-vector-icons/material-icons",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3ee9bd6b-0d28-40da-bcf9-cbce20899eb2"
      }
    }
  }
}
