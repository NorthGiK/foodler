AI_STRONG_MODEL=gpt-4o-mini

# Security
API_URL=https://proverkacheka.com/api/v1/check/get
API_QR_KEY=replace_with_receipt_api_token
QR_API_TIMEOUT_SECONDS=15
QR_UPLOAD_MAX_BYTES=10485760

