# Database
DATABASE_URL=sqlite+aiosqlite:///food_tracker.db

# AI
AI_API_KEY=
AI_BASE_URL=
AI_LIGHT_MODEL=gpt-4o-mini
AI_STRONG_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=90
PRODUCT_FUZZY_CANDIDATE_LIMIT=300

# Security
API_URL=https://proverkacheka.com/api/v1/check/get
API_QR_KEY=replace_with_receipt_api_token
QR_API_TIMEOUT_SECONDS=15
QR_UPLOAD_MAX_BYTES=10485760
RECEIPT_PAGE_SIZE_MAX=100

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-at-least-32-random-characters
# Old signing keys may be kept briefly during a controlled rotation.
PREVIOUS_SECRET_KEYS=
JWT_ISSUER=foodler-api
JWT_AUDIENCE=foodler-mobile
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false
TRUST_PROXY_HEADERS=false

# Payment (YooKassa)
PAYMENT_ACCOUNT_ID=
PAYMENT_SECRET_KEY=
SUBSCRIPTION_PERIOD_DAYS=30
PAYMENT_TIMEOUT_SECONDS=10
PAYMENT_MAX_ATTEMPTS=2
PAYMENT_AMOUNT_RUB=5.00
PAYMENT_RETURN_URL=https://foodler.site/

# Google Play subscriptions
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_TIMEOUT_SECONDS=10
GOOGLE_PLAY_PRODUCT_IDS=premium_monthly

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
SMTP_TIMEOUT_SECONDS=10

# Runtime
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
RECEIPT_CLEANUP_INTERVAL_SECONDS=3600
# Empty disables /metrics (returns 404).
METRICS_TOKEN=
